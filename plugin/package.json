{
  "name": "dsh-update-plugin",
  "version": "0.1.0",
  "description": "DSH Web plugin: check and update DeepSeek Harness CLI and all profile plugins from Settings → General.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haotian-lu-prog/dsh-update-all.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/haotian-lu-prog/dsh-update-all/tree/main/plugin",
  "bugs": {
    "url": "https://github.com/haotian-lu-prog/dsh-update-all/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "assets",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.8 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.8 || 0.1.1-rc.2 || 0.1.2-rc.1 || 0.1.5-rc.1 || 0.1.5-rc.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "updater",
    "cordis"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
